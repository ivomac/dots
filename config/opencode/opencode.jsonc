{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.5-free",
  "small_model": "opencode/mimo-v2.5-free",
  "default_agent": "plan",
  "autoupdate": false,
  "share": "manual",
  "snapshot": false,
  "username": "Ivo",
  "disabled_providers": [],
  "permission": {
    "read": {
      "**/*.ipynb": "deny"
    },
    "bash": {
      "*": "ask",

      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "pwd *": "allow",

      "echo": "allow",
      "echo *": "allow",
      "printf": "allow",
      "printf *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "sort": "allow",
      "sort *": "allow",

      "mkdir": "allow",
      "mkdir *": "allow",

      "wc": "allow",
      "wc *": "allow",
      "tr": "allow",
      "tr *": "allow",
      "sed": "allow",
      "sed *": "allow",
      "awk": "allow",
      "awk *": "allow",
      "find": "allow",
      "find *": "allow",
      "fd": "allow",
      "fd *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "jq": "allow",
      "jq *": "allow",

      "stat": "allow",
      "stat *": "allow",
      "du": "allow",
      "du *": "allow",

      "nb": "allow",
      "nb pull *": "allow",
      "nb push *": "allow",
      "nb outputs *": "allow",
      "nb run *": "ask",

      "jupytext": "allow",
      "jupytext *": "allow",
      "cat *.ipynb": "deny",

      "basename": "allow",
      "basename *": "allow",
      "dirname": "allow",
      "dirname *": "allow",
      "realpath": "allow",
      "realpath *": "allow",

      "file": "allow",
      "file *": "allow",
      "readlink": "allow",
      "readlink *": "allow",

      "tree": "allow",
      "tree *": "allow",

      "diff": "allow",
      "diff *": "allow",
      "cmp": "allow",
      "cmp *": "allow",

      "cut": "allow",
      "cut *": "allow",
      "paste": "allow",
      "paste *": "allow",
      "column": "allow",
      "column *": "allow",

      "uniq": "allow",
      "uniq *": "allow",
      "comm": "allow",
      "comm *": "allow",

      "md5": "allow",
      "md5 *": "allow",
      "md5sum": "allow",
      "md5sum *": "allow",
      "sha1sum": "allow",
      "sha1sum *": "allow",
      "sha256sum": "allow",
      "sha256sum *": "allow",
      "shasum": "allow",
      "shasum *": "allow",

      "date": "allow",
      "date *": "allow",
      "uname": "allow",
      "uname *": "allow",
      "hostname": "allow",

      "which": "allow",
      "which *": "allow",
      "type": "allow",
      "type *": "allow",

      "env": "allow",
      "env *": "allow",

      "git log": "allow",
      "git log *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git ls-tree": "allow",
      "git ls-tree *": "allow",
      "git blame": "allow",
      "git blame *": "allow",
    },
    "edit": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow"
  },
  "command": {},
  "watcher": {
    "ignore": []
  },
  "plugin": [],
  "instructions": [],
  "provider": {},
  "mcp": {},
  "lsp": false,
  "formatter": false,
  "experimental": {
    "disable_paste_summary": false
  }
}
