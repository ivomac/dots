#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
LOCAL="$HOME/.local"
BIN="$LOCAL/bin"

info()  { printf "\033[1;34m==>\033[0m %s\n" "$1"; }
warn()  { printf "\033[1;33mWARN:\033[0m %s\n" "$1"; }
skip()  { printf "\033[1;90m---\033[0m %s already installed, skipping\n" "$1"; }

have() { command -v "$1" &>/dev/null; }

install_tool() {
  local name="$1"
  if have "$name"; then
    skip "$name"
    return 1
  fi
  info "Installing $name"
  return 0
}

info "Creating directories"
mkdir -p "$BIN" "$LOCAL/lib" "$LOCAL/colors"
mkdir -p "$HOME/.config" "$HOME/.local/share" "$HOME/.cache" "$HOME/.local/state"
mkdir -p "$HOME/Docs/.local/share"

export PATH="$BIN:$PATH"

info "Installing system packages (may need sudo)"
sudo apt update -qq
sudo apt upgrade -y -qq
sudo apt install -y -qq \
  build-essential curl unzip xz-utils \
  libcurl4-gnutls-dev libexpat1-dev gettext libz-dev libssl-dev \
  libncurses-dev libclang-dev ninja-build cmake git jq tar stow

if ! command -v zsh &>/dev/null || [[ "$(printf '%s\n5.9' "$(zsh --version | grep -oP '\d+\.\d+\.\d+')" | sort -V | head -1)" != "5.9" ]]; then
  info "Building zsh from source"
  ZSH_VERSION="5.9.2"
  ZSH_TMPDIR="$(mktemp -d)"
  curl -sL "https://sourceforge.net/projects/zsh/files/zsh/${ZSH_VERSION}/zsh-${ZSH_VERSION}.tar.xz" | tar -xJ -C "$ZSH_TMPDIR"
  (
    cd "$ZSH_TMPDIR/zsh-${ZSH_VERSION}"
    ./configure --prefix="$HOME/.local" --enable-etcdir="/etc/zsh"
    make -j"$(nproc)"
    make install
  )
  rm -rf "$ZSH_TMPDIR"
  info "zsh $(zsh --version | awk '{print $2}') installed"
fi

if ! have cargo; then
  info "Installing Rust via rustup"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
  rustup default stable
  for bin in cargo rustc rustup; do
    ln -sf "$HOME/.cargo/bin/$bin" "$BIN/$bin" 2>/dev/null || true
  done
  info "Rust installed"
else
  skip "cargo"
fi

[[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH"

if ! command -v git &>/dev/null || [[ "$(printf '%s\n2.55.0' "$(git version | grep -oP '\d+\.\d+\.\d+')" | sort -V | head -1)" != "2.55.0" ]]; then
  info "Building git from source"
  GIT_VERSION="2.55.0"
  GIT_TMPDIR="$(mktemp -d)"
  curl -sL "https://kernel.org/pub/software/scm/git/git-${GIT_VERSION}.tar.xz" | tar -xJ -C "$GIT_TMPDIR"
  make -C "$GIT_TMPDIR/git-${GIT_VERSION}" -j"$(nproc)" prefix="$HOME/.local" all
  make -C "$GIT_TMPDIR/git-${GIT_VERSION}" prefix="$HOME/.local" install
  rm -rf "$GIT_TMPDIR"
  info "git $(git --version | awk '{print $3}') installed"
fi


info "Writing env/local.sh"
mkdir -p "$HOME/.config/zsh/env"
cat > "$HOME/.config/zsh/env/local.sh" << 'ENVEOF'
# env/local.sh - generated by wokbench-setup
# Adds local tool paths. Precedence: local > system.

# Local binaries (highest priority)
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)

# Rust/Cargo
[[ -d "$HOME/.cargo/bin" ]] && path=("$HOME/.cargo/bin" $path)

# Node.js
[[ -d "$HOME/.local/node/bin" ]] && path=("$HOME/.local/node/bin" $path)

# Go
[[ -d "$HOME/go/bin" ]] && path=("$HOME/go/bin" $path)
ENVEOF

if install_tool nvim; then
  info "Building Neovim from source"
  NVIM_VERSION="stable"
  NVIM_TMPDIR="$(mktemp -d)"
  curl -sL "https://github.com/neovim/neovim/archive/refs/tags/${NVIM_VERSION}.tar.gz" | tar -xz -C "$NVIM_TMPDIR"
  make -C "$NVIM_TMPDIR/neovim-${NVIM_VERSION}" CMAKE_BUILD_TYPE=RelWithDebInfo
  make -C "$NVIM_TMPDIR/neovim-${NVIM_VERSION}" install PREFIX="$LOCAL"
  rm -rf "$NVIM_TMPDIR"
  info "Neovim installed"
fi

if install_tool node; then
  info "Downloading Node.js LTS"
  NODE_VERSION="22.16.0"
  NODE_URL="https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz"
  curl -sL "$NODE_URL" | tar -xJ -C "$LOCAL"
  mv "$LOCAL/node-v${NODE_VERSION}-linux-x64" "$LOCAL/node"
  ln -sf "$LOCAL/node/bin/node" "$BIN/node"
  ln -sf "$LOCAL/node/bin/npm" "$BIN/npm"
  ln -sf "$LOCAL/node/bin/npx" "$BIN/npx"
  info "Node.js installed"
fi

if install_tool gh; then
  info "Downloading GitHub CLI"
  GH_LATEST="$(curl -sL 'https://api.github.com/repos/cli/cli/releases/latest' | jq -r '.tag_name')"
  GH_VER="${GH_LATEST#v}"
  GH_URL="https://github.com/cli/cli/releases/download/${GH_LATEST}/gh_${GH_VER}_linux_amd64.tar.gz"
  curl -sL "$GH_URL" | tar -xz --strip-components=2 -C "$BIN" "gh_${GH_VER}_linux_amd64/bin/gh"
  chmod +x "$BIN/gh"
fi

if have gh && ! gh auth status &>/dev/null 2>&1; then
  info "Authenticating GitHub CLI"
  gh auth login -p https
fi

if install_tool uv; then
  info "Downloading uv"
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
fi

if install_tool python3.12; then
  info "Installing Python 3.12 via uv"
  uv python install --default 3.12 2>/dev/null || warn "Python 3.12 (default) install failed"
fi
if install_tool python3.13; then
  info "Installing Python 3.13 via uv"
  uv python install 3.13 2>/dev/null || warn "Python 3.13 install failed"
fi
if install_tool python3.14; then
  info "Installing Python 3.14 via uv"
  uv python install 3.14 2>/dev/null || warn "Python 3.14 install failed"
fi

gh_download() {
  local repo="$1" asset="$2"
  if have gh && gh auth status &>/dev/null 2>&1; then
    local url
    url="$(gh api "repos/$repo/releases/latest" --jq ".assets[] | select(.name==\"$asset\") | .browser_download_url")"
    echo "$url"
  else
    curl -sL "https://api.github.com/repos/$repo/releases/latest" | \
      jq -r ".assets[] | select(.name==\"$asset\") | .browser_download_url"
  fi
}

gh_download_arch() {
  local repo="$1" pattern="$2"
  local json
  if have gh && gh auth status &>/dev/null 2>&1; then
    json="$(gh api "repos/$repo/releases/latest")"
  else
    json="$(curl -sL "https://api.github.com/repos/$repo/releases/latest")"
  fi
  echo "$json" | tr -d '\000-\037' | jq -r --arg p "$pattern" \
    'if .assets then .assets[] | select(.name | test($p)) | .browser_download_url else empty end' | head -1
}

if install_tool starship; then
  url="$(gh_download_arch "starship/starship" "x86_64-unknown-linux-musl.*\.tar\.gz")"
  if [[ -n "$url" ]]; then
    curl -sL "$url" | tar -xz -C "$BIN" starship
    chmod +x "$BIN/starship"
  else
    warn "starship: no binary found, install manually"
  fi
fi

if install_tool fzf; then
  url="$(gh_download_arch "junegunn/fzf" "linux_amd64.*\.tar\.gz")"
  if [[ -n "$url" ]]; then
    curl -sL "$url" | tar -xz -C "$BIN" fzf
    chmod +x "$BIN/fzf"
  else
    warn "fzf: no binary found, install manually"
  fi
fi

if install_tool fd; then
  url="$(gh_download_arch "sharkdp/fd" "fd-.*-x86_64-unknown-linux-musl.*\.tar\.gz")"
  if [[ -n "$url" ]]; then
    TMPDIR_TAR="$(mktemp -d)"
    curl -sL "$url" | tar -xz -C "$TMPDIR_TAR"
    mv "$TMPDIR_TAR"/fd-*/fd "$BIN/fd"
    chmod +x "$BIN/fd"
    rm -rf "$TMPDIR_TAR"
  else
    warn "fd: no binary found, install manually"
  fi
fi

if install_tool rg; then
  url="$(gh_download_arch "BurntSushi/ripgrep" "ripgrep-.*-x86_64-unknown-linux-musl.*\.tar\.gz")"
  if [[ -n "$url" ]]; then
    TMPDIR_TAR="$(mktemp -d)"
    curl -sL "$url" | tar -xz -C "$TMPDIR_TAR"
    mv "$TMPDIR_TAR"/ripgrep-*/rg "$BIN/rg"
    chmod +x "$BIN/rg"
    rm -rf "$TMPDIR_TAR"
  else
    warn "rg: no binary found, install manually"
  fi
fi

if install_tool lazygit; then
  url="$(gh_download_arch "jesseduffield/lazygit" "lazygit_.*_linux_x86_64.*\.tar\.gz")"
  if [[ -n "$url" ]]; then
    curl -sL "$url" | tar -xz -C "$BIN" lazygit
    chmod +x "$BIN/lazygit"
  else
    warn "lazygit: no binary found, install manually"
  fi
fi

if install_tool yazi; then
  url="$(gh_download_arch "sxyazi/yazi" "yazi-.*x86_64-unknown-linux-musl.*\.zip")"
  if [[ -n "$url" ]]; then
    TMPDIR_ZIP="$(mktemp -d)"
    curl -sL "$url" -o "$TMPDIR_ZIP/yazi.zip" 2>/dev/null
    unzip -oq "$TMPDIR_ZIP/yazi.zip" -d "$TMPDIR_ZIP"
    mv "$TMPDIR_ZIP"/yazi-*/yazi "$BIN/yazi"
    mv "$TMPDIR_ZIP"/yazi-*/ya "$BIN/ya"
    chmod +x "$BIN/yazi" "$BIN/ya"
    rm -rf "$TMPDIR_ZIP"
    ya pkg upgrade 2>/dev/null || true
  else
    warn "yazi: no binary found, install manually"
  fi
fi

if install_tool bat; then
  url="$(gh_download_arch "sharkdp/bat" "bat-.*-x86_64-unknown-linux-musl.*\.tar\.gz")"
  if [[ -n "$url" ]]; then
    TMPDIR_TAR="$(mktemp -d)"
    curl -sL "$url" | tar -xz -C "$TMPDIR_TAR"
    mv "$TMPDIR_TAR"/bat-*/bat "$BIN/bat"
    chmod +x "$BIN/bat"
    rm -rf "$TMPDIR_TAR"
  else
    warn "bat: no binary found, install manually"
  fi
fi

if install_tool eza; then
  url="$(gh_download_arch "eza-community/eza" "x86_64-unknown-linux-musl.*\.tar\.gz")"
  if [[ -n "$url" ]]; then
    curl -sL "$url" | tar -xz -C "$BIN" --strip-components=0 --wildcards '*/eza'
    chmod +x "$BIN/eza"
  else
    warn "eza: no binary found, install manually"
  fi
fi

if install_tool tmux; then
  url="$(gh_download_arch "tmux/tmux-builds" "tmux-.*-linux-x86_64.*\.tar\.gz")"
  if [[ -n "$url" ]]; then
    curl -sL "$url" | tar -xz -C "$BIN" tmux
    chmod +x "$BIN/tmux"
  else
    warn "tmux: no binary found, install manually"
  fi
fi

if install_tool shellcheck; then
  url="$(gh_download_arch "koalaman/shellcheck" "shellcheck-.*linux.x86_64.*\.tar\.xz")"
  if [[ -n "$url" ]]; then
    curl -sL "$url" | tar -xJ -C "$BIN" --strip-components=1
    chmod +x "$BIN/shellcheck"
  else
    warn "shellcheck: no binary found, install manually"
  fi
fi

if install_tool gitleaks; then
  url="$(gh_download_arch "gitleaks/gitleaks" "gitleaks_.*_linux_x64\.tar\.gz")"
  if [[ -n "$url" ]]; then
    curl -sL "$url" | tar -xz -C "$BIN" gitleaks
    chmod +x "$BIN/gitleaks"
  else
    warn "gitleaks: no binary found for linux x86_64, install manually"
  fi
fi

if install_tool opencode; then
  url="$(gh_download_arch "anomalyco/opencode" "opencode-linux-x64\.tar\.gz")"
  if [[ -n "$url" ]]; then
    curl -sL "$url" | tar -xz -C "$BIN" opencode
    chmod +x "$BIN/opencode"
  else
    warn "opencode: no binary found for linux amd64, install manually"
  fi
fi

if have npm; then
  info "Installing npm-based LSP servers"
  for pkg in bash-language-server vscode-langservers-extracted \
    typescript-language-server vim-language-server \
    yaml-language-server marksman oxfmt; do
    if npm list -g "$pkg" &>/dev/null; then
      skip "$pkg"
    elif npm install -g --silent "$pkg" 2>/dev/null; then
      info "$pkg installed"
    else
      warn "$pkg failed to install"
    fi
  done
fi

if have cargo; then
  if have taplo; then
    skip "taplo"
  elif cargo install --quiet --locked --features lsp taplo-cli 2>/dev/null; then
    info "taplo installed"
  else
    warn "taplo failed to install"
  fi
fi

if have uv; then
  info "Installing Python tools"
  for tool in basedpyright ruff ty pyrefly mypy hatch git-filter-repo; do
    if uv tool list 2>/dev/null | grep -q "^$tool"; then
      skip "$tool"
    elif uv tool install --python 3.12 "$tool" 2>/dev/null; then
      info "$tool installed"
    else
      warn "$tool failed to install"
    fi
  done
fi

if install_tool rust-analyzer; then
  url="$(gh_download_arch "rust-lang/rust-analyzer" "rust-analyzer-x86_64-unknown-linux-gnu\.gz")"
  curl -sL "$url" | gunzip > "$BIN/rust-analyzer"
  chmod +x "$BIN/rust-analyzer"
fi

if install_tool tree-sitter; then
  cargo install --quiet tree-sitter-cli 2>/dev/null || warn "tree-sitter: install manually if cargo install fails"
fi

if ! have clangd; then
  warn "clangd not installed - install via apt or download from LLVM releases"
fi

info "Stowing dotfiles"
cd "$DOTFILES_DIR"
./restow

info "Setting default theme"
theme-switch gruvbox_dark 2>/dev/null || warn "theme-switch not available, run manually after shell restart"

info "Setup complete!"
echo ""
echo "Next steps:"
echo "  1. chsh -s $BIN/zsh"
echo "  2. Log out and back in (or run: exec $BIN/zsh)"
echo "  3. Zsh plugins will auto-clone on first shell launch"
echo ""
